            "error",
            {
                "max": 1
            }
        ]
    },
    "4.3.2 Semicolons are required": {
        "semi": [
            "error",
            "always"
        ]
    },
    "4.4 Column limit: 80": {
        "max-len": [
            "error",
            {
                "ignoreUrls": true,
                "ignoreStrings": true,
                "ignorePattern": "OurSetDefault"
            }
        ]
    },
    "4.5 Line-wrapping": {},
    "4.5.1 Where to break": {
        "operator-linebreak": [
            "error",
            "after"
        ],
        "space-before-function-paren": [
            "error",
            "never"
        ],
        "comma-style": [
            "error",
            "last"
        ],
        "comma-spacing": [
            "error",
            {
                "before": false
            }
        ]
    },
    "4.5.2 Indent continuation lines at least +4 spaces": {
        "indent": [
            "error",
            2,
            {
                "VariableDeclarator": 2,
                "MemberExpression": 2,
                "FunctionDeclaration": {
                    "body": 1,
                    "parameters": 2
                },
                "FunctionExpression": {
                    "body": 1,
                    "parameters": 2
                },
                "CallExpression": {
                    "arguments": 2
                }
            }
        ]
    },
    "4.6 Whitespace": {},
    "4.6.1 Vertical whitespace": {
        "padding-line-between-statements": [
            "error",
            {
                "blankLine": "always",
                "prev": "function",
                "next": "function"
            }
        ],
        "lines-between-class-members": [
            "error",
            {
                "enforce": [
                    {
                        "blankLine": "always",
                        "prev": "method",
                        "next": "method"
                    }
                ]
            }
        ],
        "padded-blocks": [
            "error",
            "never"
        ]
    },
    "4.6.2 Horizontal whitespace": {
